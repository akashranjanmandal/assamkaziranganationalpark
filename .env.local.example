# Supabase — public (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth (NextAuth Credentials provider)
# Generate a bcrypt hash of your chosen admin password, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional until you add a webhook endpoint in the Razorpay Dashboard
# (Settings -> Webhooks -> URL: https://<your-domain>/api/razorpay/webhook,
# event: payment.captured). This is a DIFFERENT secret from
# RAZORPAY_KEY_SECRET above — copy it from the webhook you create there.
RAZORPAY_WEBHOOK_SECRET=

# Optional: only needed if you switch file uploads to Vercel Blob storage
# instead of the default Supabase Storage private bucket.
BLOB_READ_WRITE_TOKEN=
